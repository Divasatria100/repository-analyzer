# RepoLens backend environment example (local development).
# Copy to `.env` and adjust. `.env` is git-ignored — never commit secrets.
# Every value below maps to docs/15 §9.1. Fixed values (pagination) are
# intentionally absent: overriding them fails closed at startup.

REPOLENS_ENVIRONMENT=local

# --- Application ---
# REPOLENS_APPLICATION__NAME=RepoLens API
# REPOLENS_APPLICATION__DEBUG=false

# --- Database (RepoLens application database only) ---
REPOLENS_DATABASE__URL=postgresql+psycopg://localhost:5432/repolens
# REPOLENS_DATABASE__ECHO=false

# --- Network / HTTP clients (seconds / retries) ---
# REPOLENS_NETWORK__CONNECT_TIMEOUT_S=10
# REPOLENS_NETWORK__READ_TIMEOUT_S=60
# REPOLENS_NETWORK__RETRIEVAL_TOTAL_S=600
# REPOLENS_NETWORK__RETRIES_METADATA=2
# REPOLENS_NETWORK__RETRIES_RETRIEVAL=1
# REPOLENS_NETWORK__ADVISORY_TIMEOUT_S=30

# --- Operational limits (see docs/15 §9.1 for units and Min/Max) ---
# REPOLENS_OPERATIONAL__REPO_MAX_SIZE_BYTES=209715200
# REPOLENS_OPERATIONAL__FILE_MAX_SIZE_BYTES=1048576
# REPOLENS_OPERATIONAL__INDEX_MAX_FILES=20000
# REPOLENS_OPERATIONAL__INDEX_MAX_DEPTH=32
# REPOLENS_OPERATIONAL__ANALYSIS_TIMEOUT_TOTAL_S=1800
# REPOLENS_OPERATIONAL__PARSE_FILE_TIMEOUT_S=30
# REPOLENS_OPERATIONAL__ANALYSIS_MEMORY_MAX_MB=2048
# REPOLENS_OPERATIONAL__ANALYSIS_STORAGE_MAX_MB=5120
# REPOLENS_OPERATIONAL__GRAPH_MAX_NODES=10000
# REPOLENS_OPERATIONAL__GRAPH_MAX_EDGES=50000
# REPOLENS_OPERATIONAL__REPORT_MAX_SIZE_MB=25
# REPOLENS_OPERATIONAL__CONCURRENCY_MAX_ANALYSES=2
# REPOLENS_OPERATIONAL__SWEEP_STALE_THRESHOLD_H=24
# REPOLENS_OPERATIONAL__EVIDENCE_CONTEXT_LINES_EACH_SIDE=10
# REPOLENS_OPERATIONAL__EVIDENCE_MAX_EXCERPT_LINES=40

# --- Logging (DEBUG, INFO, WARNING, ERROR, CRITICAL; empty = per environment) ---
# REPOLENS_LOGGING__LEVEL=

# --- Workspace (disposable per-analysis directories; empty = system temp dir) ---
# REPOLENS_WORKSPACE__ROOT=
