# RepoLens local development environment (Docker Compose).
# Copy to `.env` and adjust. `.env` is git-ignored — never commit secrets.
#
# All values below are safe local-development defaults. Compose works
# without a `.env` file; these variables only override the defaults.

# --- PostgreSQL (RepoLens application database only) ---
POSTGRES_DB=repolens
POSTGRES_USER=repolens
# Local-dev password only. If you change it, use URL-safe characters
# (or percent-encode) because it is embedded in REPOLENS_DATABASE__URL.
POSTGRES_PASSWORD=repolens-dev-only

# --- Backend ---
REPOLENS_ENVIRONMENT=local
# Composed automatically from the POSTGRES_* values above when unset;
# override only to point at an external database.
# REPOLENS_DATABASE__URL=postgresql+psycopg://repolens:repolens-dev-only@postgres:5432/repolens

# --- Frontend ---
# Public base URL for FUTURE frontend -> backend calls (browser resolves
# this, so it must be a host-reachable address, not a Compose hostname).
# Never put secrets in VITE_* variables.
VITE_API_BASE_URL=http://localhost:8000
